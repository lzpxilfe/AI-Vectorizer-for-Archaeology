{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen USGS contour learning pilot dataset",
  "type": "object",
  "required": ["schema_version", "dataset_id", "seed", "publication_ranking_eligible", "split_policy", "sources", "samples"],
  "properties": {
    "schema_version": {"const": "archaeotrace-learning-dataset/1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "seed": {"type": "string", "minLength": 1},
    "publication_ranking_eligible": {"const": false},
    "split_policy": {"type": "object", "required": ["assignment_unit", "frozen", "source_counts", "sample_counts"], "properties": {"assignment_unit": {"const": "sheet_family"}, "frozen": {"const": true}, "source_counts": {"type": "object"}, "sample_counts": {"type": "object"}}},
    "sources": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "object", "required": ["id", "family_id", "quadrangle_name", "state", "split", "source_url", "source_sha256", "provenance_id", "rights_status", "license", "rights_statement_url", "rights_snapshot", "rights_snapshot_sha256"], "properties": {"id": {"type": "string"}, "split": {"$ref": "#/$defs/split"}, "source_sha256": {"$ref": "#/$defs/hash"}, "rights_status": {"enum": ["public_domain", "open_license"]}}}},
    "samples": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "object", "required": ["id", "source_id", "split", "source_crop_xywh", "source_tile_origin_xy", "image", "image_sha256", "image_pixel_sha256", "geotransform", "annotation"], "properties": {"split": {"$ref": "#/$defs/split"}, "image_sha256": {"$ref": "#/$defs/hash"}, "image_pixel_sha256": {"$ref": "#/$defs/hash"}, "geotransform": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6}, "source_crop_xywh": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4}, "source_tile_origin_xy": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2}}}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "split": {"enum": ["train", "validation", "calibration", "holdout"]}}
}
